{
  "name": "devextreme-cli",
  "version": "1.19.0",
  "description": "DevExtreme CLI",
  "keywords": [
    "devexpress",
    "devextreme",
    "cli",
    "themebuilder",
    "theme",
    "application"
  ],
  "bin": {
    "devextreme": "index.js"
  },
  "engines": {
    "node": ">20.19.0",
    "npm": ">9.6.0",
    "yarn": ">1.21"
  },
  "files": [
    "src/**/*",
    "index.js"
  ],
  "scripts": {
    "lint": "eslint ./",
    "test": "pnpm run create-template && pnpm run verify-template && pnpm run lint-template && pnpm run test-template && pnpm run test-themebuilder",
    "create-template": "node ./testing/creating.js",
    "verify-template": "node ./testing/verifying.js",
    "lint-template": "node ./testing/linting.js",
    "test-template": "node ./testing/testing.js",
    "test-dev": "cross-env TEST_MODE=dev vitest run",
    "test-themebuilder": "vitest run --config ./vitest.themebuilder.config.mjs",
    "docker:build": "docker build --rm -f \"testing/docker/Dockerfile\" -t devextreme-cli:latest \"testing/docker\" --progress=plain",
    "docker:run": "docker run --rm -d  -p 9222:9222/tcp devextreme-cli:latest"
  },
  "author": "Developer Express Inc.",
  "repository": "https://github.com/DevExpress/devextreme-cli",
  "license": "MIT",
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "import-cwd": "^3.0.0",
    "less": "^4.8.1",
    "minimist": "^1.2.8",
    "mustache": "^3.2.1",
    "prompts": "^2.4.2",
    "sass": "^1.101.0",
    "semver": "^5.7.2",
    "strip-bom": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "create-vite": "7.1.3",
    "cross-env": "^5.2.1",
    "eslint": "catalog:",
    "eslint-config-angular": "^0.5.0",
    "eslint-plugin-angular": "^5.1.0",
    "globals": "^17.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^2.8.8",
    "rimraf": "^2.7.1",
    "tree-kill": "^1.2.2",
    "tree-kill-promise": "^1.0.12",
    "typescript": "^4.9.5",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "wait-on": "8.0.5"
  }
}
